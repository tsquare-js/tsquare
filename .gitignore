# Ignore everything by default; allow only what belongs in the repo.
# New files stay untracked until they're listed here.
*
!*/

!/.gitignore
!/README.md
!/.github/workflows/*.yml
!/test/*.ts
!/CHANGELOG.md
!/LICENSE
!/package.json
!/package-lock.json
!/tsconfig.json

!/src/**/*.ts
!/src/**/*.tsx
!/bin/*.js
!/src/**/*.html
!/scripts/*.ts
!/tsconfig.build.json
!/skill/*.ts
!/skill/tsquare/*.md
!/docs/*.ts
!/docs/**/*.md
!/docs/components/images/*.png
!/docs/*.png
!/assets/*.png
!/assets/*.svg
!/examples/*.tsq
!/examples/*.png

# eval/renders/ is left out on purpose: `npm run eval:score` regenerates it
!/eval/*.ts
!/eval/*.md
!/eval/results.json
!/eval/prompts/*.md
!/eval/out/**/*.json
!/eval/out/**/*.wf
!/eval/out/**/*.tsq

# repair-round eval
!/eval/repair/*.ts
!/eval/repair/*.json
!/eval/repair/items/**/*.md
!/eval/repair/out/**/*.tsq

# color eval (eval/colors/renders/ is regenerated by its score.ts)
!/eval/colors/*.ts
!/eval/colors/*.md
!/eval/colors/results.json
!/eval/colors/out/**/*.wf

        listitem title="Product 3" trailingText="$19.99" subtitle="Category"
        listitem title="Product 4" trailingText="$39.99" subtitle="Category"
        listitem title="Product 5" trailingText="$59.99" subtitle="Category"
      pagination pages=9 current=2

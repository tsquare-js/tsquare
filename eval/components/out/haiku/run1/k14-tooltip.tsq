board "Editor"
  screen desktop "Document"
    heading "Document" level=2
    stack row gap=8 padding=12 fill
      button variant=ghost size=sm leadingIcon=bold tooltip="Bold"
      button variant=ghost size=sm leadingIcon=italic tooltip="Italic"
      button variant=ghost size=sm leadingIcon=link tooltip="Insert link (⌘K)"
      button variant=ghost size=sm leadingIcon=image tooltip="Insert image"

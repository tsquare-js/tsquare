board "Sign-in Flow"
  screen phone "Sign in" #signin
    heading "Sign in" level=1
    input label="Email" placeholder="you@example.com"
    input label="Password" type=password
    button primary "Sign in" #signin-btn fullWidth
    text center size=sm
    button ghost "Create an account" #create-link
  screen phone "Home" #home
    navbar "Home" leading=menu
    heading "Welcome back" level=1
    text "Dashboard content"
    button primary "Sign out" #signout-btn
  screen phone "Sign up" #signup
    heading "Create account" level=1
    input label="Email" placeholder="you@example.com"
    input label="Password" type=password
    input label="Confirm password" type=password
    button primary "Sign up" fullWidth
  flow signin-btn -> home "Sign in"
  flow create-link -> signup "Create account"
  flow signout-btn -> signin "Sign out"

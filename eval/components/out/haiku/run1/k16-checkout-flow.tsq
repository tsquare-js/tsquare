board "Checkout Flow"
  screen phone "Cart" #cart
    heading "Shopping Cart" level=1
    list dividers
      listitem title="Product A" trailing=text trailingText="$29.99"
      listitem title="Product B" trailing=text trailingText="$19.99"
    spacer size=16
    text bold "Total: $49.98"
    button primary "Continue" #cart-continue fullWidth
  screen phone "Shipping" #shipping
    heading "Shipping Address" level=1
    input label="Full name" placeholder="Name"
    input label="Street address"
    input label="City"
    input label="Postal code"
    button primary "Continue" #shipping-continue fullWidth
  screen phone "Payment" #payment
    heading "Payment Method" level=1
    input label="Card number" placeholder="1234 5678 9012 3456"
    stack row gap=12
      input label="Expiry" width=120
      input label="CVV" width=80
    button primary "Complete order" #payment-continue fullWidth
    button secondary "Edit cart" #edit-cart
  screen phone "Confirmation" #confirmation
    heading "Order confirmed" level=1
    text "Thank you for your purchase"
    text "Order number: #12345"
    button primary "Continue shopping" fullWidth
  flow cart-continue -> shipping "Continue"
  flow shipping-continue -> payment "Continue"
  flow payment-continue -> confirmation "Place order"
  flow edit-cart -> cart "Edit cart" dashed

```tsquare
board "Sign-in Flow"
  screen phone "Sign in" #signin
    navbar "Sign in"
    heading "Welcome" level=1
    input "Email" placeholder="you@example.com" type=email
    input "Password" placeholder="Password" type=password
    button primary "Sign in" fullWidth #signinBtn
    stack row gap=8 justify=center padding=16
      text "New here?"
      button ghost "Create an account" #signupLink
  screen phone "Home" #home
    navbar "Home" leading=menu actions=[bell, user]
    heading "Welcome back" level=1
    text "You are signed in"
    button "Sign out" #signoutBtn
  screen phone "Sign up" #signup
    navbar "Sign up" leading=back
    heading "Create account" level=1
    input "Email" placeholder="you@example.com" type=email
    input "Password" placeholder="Password" type=password
    button primary "Create account" fullWidth
  flow signinBtn -> home "Tap Sign in"
  flow signupLink -> signup "Create an account"
  flow signoutBtn -> signin "Tap Sign out"
```

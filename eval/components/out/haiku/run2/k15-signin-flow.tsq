board "Sign in Flow"
  screen phone "Sign in" #signin
    navbar "Sign in"
    stack padding=20 gap=16
      input label="Email" placeholder="you@example.com"
      input label="Password" type=password placeholder="••••••••"
      button primary "Sign in" fullWidth #signin-btn
      text size=sm align=center "Don't have an account?"
      button ghost "Create an account" fullWidth #signup-btn
  screen phone "Home" #home
    navbar "Home"
    stack padding=20 gap=16
      heading "Welcome back" level=2
      text "You are signed in."
      spacer
      button primary "Sign out" fullWidth #signout-btn
  screen phone "Sign up" #signup
    navbar "Sign up"
    stack padding=20 gap=16
      input label="Name" placeholder="Your name"
      input label="Email" placeholder="you@example.com"
      input label="Password" type=password placeholder="••••••••"
      button primary "Sign up" fullWidth
  flow signin-btn -> home "Sign in"
  flow signup-btn -> signup "Create account"
  flow signout-btn -> signin "Sign out"

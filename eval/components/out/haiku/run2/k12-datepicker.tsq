board "Flight Search"
  screen phone "Book Flight"
    stack gap=16 padding=16
      heading "Search Flights" level=2
      input label="From" placeholder="Departure city"
      input label="To" placeholder="Arrival city"
      input label="Departure" type=date value="2026-11-20" open
      input label="Return" placeholder="Return date"
      button primary "Search" fullWidth

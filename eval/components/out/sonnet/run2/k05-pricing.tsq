        card "Free" grow padding=16
          heading "$0" level=1
          bullets icon=check items=[1 project, Community support, {label=Custom domain icon=x muted}, {label=Analytics icon=x muted}]
          button secondary "Get started" fullWidth
        card "Pro" grow padding=16
          heading "$12" level=1
          bullets icon=check items=[10 projects, Email support, Custom domain, {label=Analytics icon=x muted}]
          button primary "Upgrade" fullWidth
        card "Team" grow padding=16
          heading "$49" level=1
          bullets icon=check items=[Unlimited projects, Priority support, Custom domain, Analytics]
          button secondary "Contact sales" fullWidth

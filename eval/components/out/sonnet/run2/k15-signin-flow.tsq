```tsquare
board "Sign-in flow"
  screen phone "Sign in" #signin
    heading "Welcome back" level=1 align=center
    input label="Email" type=email placeholder="you@example.com"
    input label="Password" type=password
    button primary "Sign in" fullWidth #signinbtn
    button ghost "Create an account" fullWidth #createbtn
  screen phone "Home" #home
    navbar "Home" actions=[bell]
    image "Hero" height=140
    text lines=3
    list dividers
      listitem title="Item one" leading=icon trailing=chevron
      listitem title="Item two" leading=icon trailing=chevron
    spacer
    button secondary "Sign out" fullWidth #signoutbtn
  screen phone "Sign up" #signup
    navbar "Sign up" leading=back
    input label="Name"
    input label="Email" type=email
    input label="Password" type=password
    button primary "Create account" fullWidth
  flow signinbtn -> home "Sign in"
  flow createbtn -> signup "Create an account"
  flow signoutbtn -> signin "Sign out"
```

```tsquare
board "Product"
  screen phone "Product"
    navbar leading=back actions=[share]
    image height=280 width=100%
    stack column padding=16 gap=12
      heading "Product name" level=2
      text size=lg bold "$99.99"
      select "Size" placeholder="Select size"
      button primary "Add to cart" fullWidth
      divider
      heading "Reviews" level=3
      list
        listitem "Great quality" subtitle="★★★★★ Jane"
        listitem "Excellent" subtitle="★★★★★ John"
        listitem "Very good" subtitle="★★★★☆ Sarah"
```

```tsquare
board "Music app"
  screen phone "Home"
    navbar "Music" leading=menu
    stack column padding=16 gap=12
      heading "Playlists" level=2
      grid columns=2 gap=12
        card padding=12
          image height=120
          text "Workout"
        card padding=12
          image height=120
          text "Chill"
    tabbar items=[{label=Home icon=home}, {label=Search icon=search}, {label=Library icon=library}, {label=Profile icon=user}] active=0
  screen phone "Now playing"
    stack column padding=20 gap=20
      image height=240 width=240
      heading "Song title" level=2
      text center "Artist name" muted
      button primary "Play" fullWidth
      button secondary "Add to playlist" fullWidth
    drawer bottom "Queue" size=200
      list
        listitem "Song 1"
        listitem "Song 2"
        listitem "Song 3"
  screen phone "Library"
    navbar "Library" leading=menu
    list
      listitem "Playlists" trailing=chevron
      listitem "Downloads" trailing=chevron
      listitem "Liked songs" trailing=chevron
    tabbar items=[{label=Home icon=home}, {label=Search icon=search}, {label=Library icon=library}, {label=Profile icon=user}] active=2
```

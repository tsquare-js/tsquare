```wireframe
board "Music app"
  screen phone "Home"
    navbar "Music" leading=menu actions=[search]
    stack padding=16 gap=16
      heading "Now Playing" level=2
      card
        image height=200 rounded
        text "Current Track" bold
        text sm "Artist Name" muted
      heading "Playlists" level=2
      list
        listitem "Liked Songs" trailing=chevron
        listitem "Discover Weekly" trailing=chevron
        listitem "Release Radar" trailing=chevron
    tabbar items=[{label=Home icon=home}, {label=Search icon=search}, {label=Library icon=music}, {label=Profile icon=user}] active=0
  screen phone "Now Playing"
    navbar leading=back actions=[share]
    stack padding=16 gap=16 align=center
      spacer size=20
      image height=300 rounded
      heading "Song Title" level=1 align=center
      text "Artist Name" align=center muted
      stack row gap=16 padding=20 justify=center
        icon "heart" size=24
        icon "repeat" size=24
        icon "shuffle" size=24
      button primary "Play" fullWidth
    drawer bottom "Queue" size=300
      list dividers
        listitem "Now Playing Track" bold
        listitem "Next Track 1"
        listitem "Next Track 2"
        listitem "Next Track 3"
  screen phone "Library"
    navbar "Library" leading=menu actions=[search]
    stack padding=16 gap=16
      heading "Your Library" level=2
      tabs items=["Playlists", "Artists", "Albums"] active=0
      list dividers
        listitem "Liked Songs" trailing=chevron
        listitem "Playlist 1" trailing=chevron
        listitem "Playlist 2" trailing=chevron
        listitem "Playlist 3" trailing=chevron
    tabbar items=[{label=Home icon=home}, {label=Search icon=search}, {label=Library icon=music}, {label=Profile icon=user}] active=2
```
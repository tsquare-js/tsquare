          text "Estimated fare: $8.50"
          button "Select" variant=ghost size=sm
        card variant=outline padding=12 gap=8
          stack row gap=12
            text "Comfort" bold
            text "5 min away" muted size=sm
          text "Estimated fare: $12.00"
          button "Select" variant=ghost size=sm
        card variant=outline padding=12 gap=8

        {
          "type": "Grid",
          "props": {
            "columns": 2,
            "gap": 12
          },
          "children": [
            {
              "type": "Card",
              "props": {
                "padding": 12
              },
              "children": [
                {
                  "type": "Image",
                  "props": {
                    "height": 100,
                    "rounded": true
                  },
                  "children": []
                },
                {
                  "type": "Text",
                  "props": {
                    "text": "Chill",
                    "bold": true,
                    "size": "sm"
                  },
                  "children": []
                }
              ]
            },
            {
              "type": "Card",
              "props": {
                "padding": 12
              },
              "children": [
                {
                  "type": "Image",
                  "props": {
                    "height": 100,
                    "rounded": true
                  },
                  "children": []
                },
                {
                  "type": "Text",
                  "props": {
                    "text": "Workout",
                    "bold": true,
                    "size": "sm"
                  },
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "type": "TabBar",
          "props": {
            "items": [
              {"label": "Home", "icon": "home"},
              {"label": "Browse", "icon": "compass"},
              {"label": "Liked", "icon": "heart"},
              {"label": "Profile", "icon": "user"}

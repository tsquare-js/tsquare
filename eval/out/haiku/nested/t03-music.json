            {
              "type": "ListItem",
              "props": {
                "title": "Recently played",
                "trailing": "chevron"
              },
              "children": []
            },
            {
              "type": "ListItem",
              "props": {
                "title": "Downloaded",
                "trailing": "chevron"
              },
              "children": []
            }
          ]
        },
        {
          "type": "TabBar",
          "props": {
            "items": [
              {"label": "Home", "icon": "home"},
              {"label": "Browse", "icon": "compass"},
              {"label": "Liked", "icon": "heart"},
              {"label": "Profile", "icon": "user"}
            ],
            "active": 3
          },
          "children": []
        }
      ]
    }

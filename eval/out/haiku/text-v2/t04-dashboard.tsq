```tsquare
board "Analytics dashboard"
  screen desktop "Dashboard"
    stack row
      stack column width=240 border=right padding=16 gap=16
        heading "Analytics" level=2
        list
          listitem "Overview" trailing=chevron
          listitem "Reports" trailing=chevron
          listitem "Settings" trailing=chevron

            input "Search" placeholder="Search..." width=240
            avatar "JD" size=40
        stack row gap=16 wrap
          card width=200
            text "12,543" bold size=lg
            text sm "Revenue" muted
          card width=200
            text "456" bold size=lg
            text sm "Orders" muted
          card width=200

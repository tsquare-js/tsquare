```tsquare
board "Product page"
  screen phone "Product"
    navbar leading=back actions=[share, more-horizontal]
    stack padding=16 gap=16 grow
      image height=300
      heading "Product Name" level=1
      text "$99.99" bold lg
      select label="Size" value="Medium"
      button "Add to cart" primary fullWidth
      heading "Reviews" level=2
      list dividers
        listitem "Excellent product" subtitle="⭐⭐⭐⭐⭐"
        listitem "Great quality" subtitle="⭐⭐⭐⭐"
        listitem "Good value" subtitle="⭐⭐⭐⭐⭐"
```

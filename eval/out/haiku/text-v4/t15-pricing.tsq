board "Pricing"
  screen desktop "Pricing Plans"
    heading "Choose your plan" level=1 align=center
    stack row gap=8 justify=center padding=20
      button "Monthly" primary
      button "Yearly" secondary
    stack row gap=20 padding=20 justify=center
      card padding=20 width=280
        text "Starter" bold
        text "$29" size=lg bold
        text sm "per month" muted
        divider
        list
          listitem "Feature one"
          listitem "Feature two"
          listitem "Feature three"
        button "Get Started" primary fullWidth
      card padding=20 width=280
        text "Professional" bold
        text "$79" size=lg bold
        text sm "per month" muted
        divider
        list
          listitem "All Starter features"
          listitem "Advanced analytics"
          listitem "Priority support"
        button "Get Started" primary fullWidth
      card padding=20 width=280
        text "Enterprise" bold
        text "Custom" size=lg bold
        text sm "contact us" muted
        divider
        list
          listitem "All features"
          listitem "Custom integration"
          listitem "Dedicated support"
        button "Contact Sales" primary fullWidth

```wireframe
board "Login"
  screen phone
    stack padding=24 gap=24 grow
      spacer size=40
      heading "Sign in" level=1 align=center
      input "Email" placeholder="you@example.com" type=email fullWidth
      input "Password" placeholder="Enter password" type=password fullWidth
      checkbox "Remember me"
      button primary "Sign in" fullWidth
      stack align=center
        text size=sm "Forgot password?"
      spacer
```

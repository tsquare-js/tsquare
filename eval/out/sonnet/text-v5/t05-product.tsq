board "Product page"
  screen phone "Product"
    navbar leading=back actions=[heart, share]
    image "Product photo" height=240
    heading "Product name" level=2
    heading "$49.00" level=3
    text lines=3
    select "Size" placeholder="Select a size"
    button primary "Add to cart" fullWidth
    divider
    heading "Reviews" level=3
    list dividers
      listitem "Great quality" subtitle="Ana T. - 5 stars" leading=avatar
      listitem "Fits well" subtitle="Sam R. - 4 stars" leading=avatar
      listitem "Good value" subtitle="Lee K. - 4 stars" leading=avatar

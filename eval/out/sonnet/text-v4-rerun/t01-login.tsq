board "Login"
  screen phone "Sign in"
    spacer size=40
    heading "Welcome back" level=1 align=center
    text "Sign in to continue" muted align=center
    spacer size=8
    input email label="Email" placeholder="you@example.com"
    input password label="Password" placeholder="Enter your password"
    stack row justify=between align=center
      checkbox "Remember me"
      button ghost sm "Forgot password?"
    button primary lg "Sign in" fullWidth

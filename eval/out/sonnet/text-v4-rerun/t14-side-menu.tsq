        listitem "Home" leadingIcon=home
        listitem "Messages" leadingIcon=mail
        listitem "Favorites" leadingIcon=heart
        listitem "Settings" leadingIcon=settings
        listitem "Help" leadingIcon=circle-help
      spacer
      button secondary "Log out" leadingIcon=log-out fullWidth

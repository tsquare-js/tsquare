board "Mail"
  screen tablet "Inbox" padding=0 gap=0
    navbar "Inbox" actions=[search, edit]
    stack row grow
      stack column width=300 border=right
        list dividers
          listitem "Ana Torres" subtitle="Project update" leading=avatar trailingText="9:41"
          listitem "Ben Lee" subtitle="Lunch tomorrow?" leading=avatar trailingText="8:15"
          listitem "Carla Diaz" subtitle="Invoice attached" leading=avatar trailingText="Mon"
          listitem "Dan Smith" subtitle="Meeting notes" leading=avatar trailingText="Sun"
          listitem "Eva Rossi" subtitle="Welcome aboard" leading=avatar trailingText="Fri"
      stack column grow padding=20 gap=12
        stack row align=center gap=12
          avatar "AT" size=40
          stack column
            text "Ana Torres" bold
            text sm "to me" muted
        heading "Project update" level=2
        divider
        text lines=6
        stack row gap=8
          button secondary leadingIcon=reply "Reply"
          button ghost leadingIcon=trash "Delete"

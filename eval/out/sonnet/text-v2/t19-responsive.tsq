```tsquare
board "Responsive notes"
  screen phone "Phone"
    navbar "Notes" leading=menu actions=[search]
    list dividers
      listitem "Meeting notes" subtitle="Today" trailing=chevron
      listitem "Shopping list" subtitle="Yesterday" trailing=chevron
      listitem "Ideas" subtitle="Mon" trailing=chevron
    button primary "New note" fullWidth
  screen desktop "Desktop"
    stack row grow
      stack width=220 border=right fill padding=12 gap=8
        button primary "New note" fullWidth
        list
          listitem "All notes" leadingIcon=file-text
          listitem "Pinned" leadingIcon=pin
          listitem "Shared" leadingIcon=users
      stack width=320 border=right
        list dividers
          listitem "Meeting notes" subtitle="Today"
          listitem "Shopping list" subtitle="Yesterday"
          listitem "Ideas" subtitle="Mon"
      stack grow padding=16 gap=8
        heading "Meeting notes" level=2
        text lines=6
  note "On phone the list fills the screen and a note opens on its own page. On desktop the sidebar, list and note editor show side by side." color=yellow width=240
```

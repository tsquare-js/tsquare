board "Chat"
  screen phone "Conversation"
    navbar "Ana Torres" leading=back actions=[phone, more-vertical]
    stack grow padding=12 gap=10
      stack row gap=8
        avatar "AT" size=32
        card padding=8
          text "Hey, are we still on for today?"
      stack align=end
        card padding=8 variant=filled
          text "Yes, see you at 5."
      stack row gap=8
        avatar "AT" size=32
        card padding=8
          text "Great, see you then!"
    stack row gap=8 padding=8 border=top align=center
      input placeholder="Message" grow
      button primary leadingIcon=send

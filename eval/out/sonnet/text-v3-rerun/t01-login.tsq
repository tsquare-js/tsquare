```tsquare
board "Login"
  screen phone "Sign in"
    stack gap=16 padding=20
      spacer size=40
      heading "Welcome back" level=1 align=center
      input "Email" type=email placeholder="you@example.com"
      input "Password" type=password placeholder="Password"
      stack row justify=between align=center
        checkbox "Remember me"
        button ghost "Forgot password?" size=sm
      button primary "Sign in" fullWidth
```

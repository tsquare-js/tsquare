board "Ride hailing"
  screen phone "Choose ride"
    image "Map" height=360
    stack padding=12 gap=8
      heading "Choose a ride" level=3
      list dividers
        listitem "Economy" subtitle="4 min away" trailingText="$12"
        listitem "Comfort" subtitle="6 min away" trailingText="$16"
        listitem "XL" subtitle="8 min away" trailingText="$22"
      button primary "Confirm ride" fullWidth

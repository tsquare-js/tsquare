board "Notes states"
  screen phone "Empty"
    navbar "Notes" actions=[search]
    stack grow align=center justify=center gap=12
      image "Illustration" height=140 width=140 rounded
      heading "No notes yet" level=2 align=center
      text "Create your first note to get started." muted align=center
      button primary "Create note"
  screen phone "Error"
    navbar "Notes" actions=[search]
    stack grow align=center justify=center gap=12
      icon alert-triangle size=48
      heading "Something went wrong" level=2 align=center
      text "We couldn't load your notes." muted align=center
      button secondary "Retry"

```wireframe
board "Checkout"
  screen phone "Cart"
    navbar "Cart" leading=back
    list dividers
      listitem "Item" subtitle="Qty 1" leading=image trailing=text trailingText="$20"
      listitem "Item" subtitle="Qty 2" leading=image trailing=text trailingText="$40"
    divider
    stack row justify=between
      text "Total" bold
      text "$60"
    button primary "Checkout" fullWidth
  screen phone "Shipping"
    navbar "Shipping" leading=back
    input label="Full name" placeholder="Full name"
    input label="Address" placeholder="Address"
    stack row gap=8
      input label="City" placeholder="City"
      input label="ZIP" placeholder="ZIP"
    select "Country" placeholder="Select country"
    button primary "Continue" fullWidth
  screen phone "Confirmation"
    navbar "Checkout" leading=back
    modal "Order placed"
      icon "check-circle" size=48
      text "Your order has been placed."
      button primary "Done" fullWidth
```

        stack row justify=between align=center
          input search placeholder="Search"
          avatar initials="JD"
        grid columns=4 gap=12
          card padding=10
            text sm "Revenue" muted
            heading "$12,400" level=2
          card padding=10
            text sm "Orders" muted
            heading "384" level=2
          card padding=10
            text sm "Customers" muted
            heading "1,204" level=2
          card padding=10
            text sm "Refunds" muted
            heading "12" level=2
        table columns=[Order, Customer, Date, Status, Total] rows=6

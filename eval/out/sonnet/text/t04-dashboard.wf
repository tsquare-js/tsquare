```wireframe
board "Analytics dashboard"
  screen desktop "Dashboard"
    stack row grow
      stack width=240 border=right padding=16 gap=8
        text "Logo" bold
        list dividers
          listitem "Dashboard" leading=icon icon=home
          listitem "Orders" leading=icon icon=shopping-cart
          listitem "Customers" leading=icon icon=users
          listitem "Settings" leading=icon icon=settings

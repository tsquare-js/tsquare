board "Checkout"
  screen phone "1. Cart"
    navbar "Cart" leading=back
    list dividers
      listitem "Item one" subtitle="Qty 1" leading=image trailingText="$30"
      listitem "Item two" subtitle="Qty 2" leading=image trailingText="$50"
    divider
    stack row justify=between
      text "Total" bold
      text "$80" bold
    spacer
    button primary "Continue to shipping" fullWidth
  screen phone "2. Shipping"
    navbar "Shipping details" leading=back
    input "Full name"
    input "Address"
    stack row gap=8
      input "City" grow
      input "ZIP" width=100
    input "Phone" helper="For delivery updates"
    spacer
    button primary "Place order" fullWidth
  screen phone "3. Confirmation"
    navbar "Confirmation"
    icon check-circle size=64
    heading "Thank you" level=2 align=center
    text lines=2
    modal "Order placed"
      text "Your order has been placed."
      button primary "Done" fullWidth

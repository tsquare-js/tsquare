board "Project settings"
  screen desktop "Settings"
    navbar "Project settings" leading=logo actions=[user]
    stack padding=24 gap=16
      heading "Settings" level=1
      card "General" padding=16 gap=10
        input "Project name" value="Apollo"
        input "Description" multiline=3
        stack row justify=end
          button primary "Save changes"
      card "Danger zone" padding=16 gap=10
        text "Deleting this project permanently removes all its data." muted
        button secondary "Delete project"
    modal "Delete project?" width=440
      text "This action cannot be undone. Type the project name to confirm."
      input "Type Apollo to confirm" placeholder="Apollo"
      stack row gap=8 justify=end
        button secondary "Cancel"
        button primary "Delete"

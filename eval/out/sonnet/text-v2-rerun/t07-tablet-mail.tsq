board "Mail"
  screen tablet "Inbox"
    stack row grow
      stack width=300 border=right
        input search placeholder="Search mail"
        list dividers
          listitem "Ana Torres" subtitle="Project update" leading=avatar trailingText="9:41"
          listitem "Ben Lee" subtitle="Lunch tomorrow?" leading=avatar trailingText="8:15"
          listitem "Cara Diaz" subtitle="Invoice attached" leading=avatar trailingText="Mon"
          listitem "Dan Wu" subtitle="Meeting notes" leading=avatar trailingText="Sun"
      stack grow padding=20 gap=12
        stack row justify=between align=center
          heading "Project update" level=2
          stack row gap=8
            icon reply
            icon trash
        stack row gap=8 align=center
          avatar "AT"
          stack
            text "Ana Torres" bold
            text sm "to me" muted
        divider
        text lines=6
        spacer
        button primary "Reply" leadingIcon=reply

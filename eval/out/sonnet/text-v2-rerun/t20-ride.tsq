board "Ride hailing"
  screen phone "Choose a ride"
    navbar "Where to?" leading=back
    image "Map" height=340
    drawer bottom "Choose a ride" size=300 scrim=false
      list dividers
        listitem "Economy" subtitle="4 min away" leadingIcon=car trailingText="$12"
        listitem "Comfort" subtitle="6 min away" leadingIcon=car trailingText="$16"
        listitem "XL" subtitle="8 min away" leadingIcon=car trailingText="$22"
      button primary "Confirm ride" fullWidth

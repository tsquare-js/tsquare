```wireframe
board "Login"
  screen phone "Sign in"
    stack padding=24 gap=16
      spacer size=40
      heading "Welcome back" level=1 align=center
      input "Email" email placeholder="you@example.com"
      input "Password" password placeholder="Enter your password"
      stack row justify=between align=center
        checkbox "Remember me"
        button ghost "Forgot password?" sm
      button primary "Sign in" fullWidth

```tsquare
board "Calendar"
  screen desktop "Calendar" height=700
    navbar "Calendar" leading=menu actions=[search, settings]
    stack row gap=12 padding=16
      button secondary "Today"
      button ghost leadingIcon=chevron-left
      button ghost leadingIcon=chevron-right
      heading "October 2026" level=2
      spacer
      button primary "New event" leadingIcon=plus
    grid columns=7 gap=8 padding=16
      text "Mon" bold
      text "Tue" bold
      text "Wed" bold
      text "Thu" bold
      text "Fri" bold
      text "Sat" bold
      text "Sun" bold
      image height=80
      image height=80
      image height=80
      image height=80
      image height=80
      image height=80
      image height=80
    modal "New event" width=480
      input "Title" placeholder="Add a title"
      stack row gap=12
        select "Date" value="Oct 14, 2026"
        select "Start time" value="9:00 AM"
        select "End time" value="10:00 AM"
      input "Description" placeholder="Add a description" multiline=4
      stack row gap=8 justify=end
        button secondary "Cancel"
        button primary "Save"
```

```tsquare
board "Responsive notes"
  screen phone "Phone"
    navbar "Notes" leading=menu actions=[search]
    list dividers
      listitem "Meeting notes" subtitle="Today" trailing=chevron
      listitem "Groceries" subtitle="Yesterday" trailing=chevron
      listitem "Ideas" subtitle="Mon" trailing=chevron
    button primary "New note" fullWidth
  screen desktop "Desktop"
    navbar "Notes" actions=[search]
    stack row grow
      stack width=220 border=right padding=12 gap=8
        button primary "New note" fullWidth
        list
          listitem "All notes" leadingIcon=file-text
          listitem "Pinned" leadingIcon=pin
          listitem "Trash" leadingIcon=trash-2
      stack grow padding=16 gap=8
        list dividers
          listitem "Meeting notes" subtitle="Today"
          listitem "Groceries" subtitle="Yesterday"
          listitem "Ideas" subtitle="Mon"
  note "On phone the sidebar collapses into a menu and the list fills the width. On desktop the sidebar stays visible next to the list." color=yellow
```

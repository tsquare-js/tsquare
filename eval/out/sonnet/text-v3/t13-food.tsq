```tsquare
board "Food delivery"
  screen phone "Home"
    navbar "Deliver to Home" leading=menu actions=[shopping-cart]
    input search placeholder="Search restaurants or dishes"
    stack row gap=8 padding=8
      badge solid "Pizza"
      badge outline "Sushi"
      badge outline "Burgers"
      badge outline "Vegan"
    grid columns=2 gap=12
      card padding=10
        image height=90
        text "Luigi's Pizza" bold
        text sm "20-30 min" muted
      card padding=10
        image height=90
        text "Sushi Go" bold
        text sm "25-35 min" muted
      card padding=10
        image height=90
        text "Burger Barn" bold
        text sm "15-25 min" muted
      card padding=10
        image height=90
        text "Green Bowl" bold
        text sm "10-20 min" muted
    tabbar items=[{label=Home icon=home}, {label=Search icon=search}, {label=Orders icon=receipt}, {label=Profile icon=user}] active=0
```

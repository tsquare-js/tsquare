```tsquare
board "Pricing"
  screen desktop "Pricing"
    navbar "Acme" leading=logo actions=[user]
    stack align=center gap=16 padding=24
      heading "Choose your plan" level=1 align=center
      tabs items=[Monthly, Yearly] active=0
      stack row gap=16
        card "Starter" padding=16 grow
          heading "$9/mo" level=2
          list
            listitem "1 project" leadingIcon=check
            listitem "Basic support" leadingIcon=check
            listitem "1 GB storage" leadingIcon=check
          button secondary "Choose Starter" fullWidth
        card "Pro" padding=16 grow
          heading "$29/mo" level=2
          list
            listitem "10 projects" leadingIcon=check
            listitem "Priority support" leadingIcon=check
            listitem "50 GB storage" leadingIcon=check
          button primary "Choose Pro" fullWidth
        card "Team" padding=16 grow
          heading "$79/mo" level=2
          list
            listitem "Unlimited projects" leadingIcon=check
            listitem "Dedicated support" leadingIcon=check
            listitem "500 GB storage" leadingIcon=check
          button secondary "Choose Team" fullWidth

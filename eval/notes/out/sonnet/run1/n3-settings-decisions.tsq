```tsquare
board "Project settings"
  screen desktop "Settings"
    stack row grow
      stack width=220 border=right padding=16 gap=8
        heading "Settings" level=3
        list
          listitem "General" leadingIcon=settings
          listitem "Members" leadingIcon=users
          listitem "Billing" leadingIcon=credit-card
          listitem "Integrations" leadingIcon=plug
        note "Sections stay in a fixed sidebar so users can jump between settings without losing their place."
      stack grow padding=24 gap=16
        heading "General" level=1
        input "Project name" value="Apollo"
        stack gap=8
          text "Visibility" bold
          radio "Public" checked
          radio "Private"
          note "Visibility is a radio choice, not a toggle, so both states are always visible."
        divider
        card title="Danger zone" gap=8
          text "Deleting a project removes all its data permanently." muted
          button secondary "Delete project" leadingIcon=trash-2
          note "Delete sits apart in its own card, away from the save actions, to prevent accidental clicks."
  note "Settings are grouped by topic, with the destructive action last."
```

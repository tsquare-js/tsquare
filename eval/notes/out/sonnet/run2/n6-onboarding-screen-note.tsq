```tsquare
board "Onboarding"
  screen phone "Welcome"
    stack grow align=center justify=center gap=16 padding=24
      image "Logo" height=120 width=120
      heading "Welcome" level=1 align=center
      text lines=2 align=center
      button primary "Get started" fullWidth
  screen phone "Interests"
    stack padding=16 gap=12
      heading "Choose your interests" level=1
      text "Pick at least 3." muted
      stack row wrap gap=8
        badge solid "Music"
        badge outline "Sports"
        badge solid "Travel"
        badge outline "Cooking"
        badge outline "Art"
        badge outline "Tech"
      button primary "Continue" fullWidth
        note "Stays disabled until at least 3 interests are selected."
  screen phone "Notifications"
    stack grow align=center justify=center gap=16 padding=24
      icon "bell" size=64
      heading "Enable notifications" level=1 align=center
      text lines=2 align=center
      button primary "Enable" fullWidth
      button ghost "Not now"
    note "This screen is skipped when the user has already granted notification permission."
```

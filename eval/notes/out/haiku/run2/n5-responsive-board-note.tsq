```tsquare
board "Notes list"
  screen phone "Notes"
    navbar "Notes" actions=[plus]
    input search placeholder="Search notes"
    list dividers
      listitem "Groceries" subtitle="Today" trailing=chevron
      listitem "Trip ideas" subtitle="Yesterday" trailing=chevron
      listitem "Meeting notes" subtitle="Mon" trailing=chevron
    tabbar items=[{label=Notes icon=file-text}, {label=Search icon=search}, {label=Settings icon=settings}] active=0
  screen desktop "Notes"
    stack row
      stack column width=220 padding=12 border=right gap=4
        listitem "All notes" leadingIcon=file-text
        listitem "Pinned" leadingIcon=pin
        listitem "Archived" leadingIcon=archive
      stack column grow padding=16 gap=12
        input search placeholder="Search notes"
        table columns=[Title, Updated] data=[[Groceries, Today], [Trip ideas, Yesterday], [Meeting notes, Mon]]
  note color=yellow "On phone the list is one column with a bottom tab bar. On desktop the same notes become a table next to a sidebar of folders."
```

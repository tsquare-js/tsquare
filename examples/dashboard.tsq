board "Analytics" accent=blue
  screen desktop "Dashboard" padding=0 height=760
    stack row grow
      stack width=220 border=right fill padding=16 gap=6
        text "Acme" bold
        list dividers=false
          listitem "Overview" leadingIcon=layout-grid
          listitem "Customers" leadingIcon=users
          listitem "Orders" leadingIcon=receipt
          listitem "Settings" leadingIcon=settings
      stack grow padding=24 gap=20
        stack row justify=between align=center
          heading "Overview" level=2
          stack row gap=8
            input search placeholder="Search" width=220
            button primary "Export" leadingIcon=download
            avatar "DM"
        grid columns=4 gap=12
          card "Revenue"
            heading "$48.2k" level=2
          card "Orders"
            heading "1,284" level=2
          card "Customers"
            heading "932" level=2
          card "Refunds"
            heading "12" level=2
        stack row gap=12
          card "Revenue" grow
            chart area height=170
          card "Traffic sources" width=300
            chart donut height=170
        table columns=[Order, Customer, Status, Total] data=[["#1042", Ana Torres, Paid, "$120"], ["#1041", Ben Cho, Pending, "$80"], ["#1040", Priya Nair, Paid, "$45"]]

{
  "name": "tsquare",
  "version": "0.14.2",
  "description": "Wireframes in plain text: easy for LLMs to write, fast to render as SVG or PNG.",
  "keywords": [
    "wireframe",
    "mockup",
    "ui",
    "diagram",
    "llm",
    "ai",
    "svg",
    "text-to-diagram",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsquare-js/tsquare.git"
  },
  "homepage": "https://github.com/tsquare-js/tsquare#readme",
  "bugs": {
    "url": "https://github.com/tsquare-js/tsquare/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./playground": {
      "types": "./dist/playground/index.d.ts",
      "import": "./dist/playground/index.js",
      "default": "./dist/playground/index.js"
    },
    "./viewer": {
      "types": "./dist/playground/viewer.d.ts",
      "import": "./dist/playground/viewer.js",
      "default": "./dist/playground/viewer.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./package.json": "./package.json"
  },
  "jsdelivr": "dist/tsquare.min.js",
  "unpkg": "dist/tsquare.min.js",
  "bin": {
    "tsquare": "bin/tsquare.js"
  },
  "files": [
    "bin/",
    "dist/",
    "skill/tsquare/",
    "examples/*.tsq",
    "assets/mark.png",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "render": "tsx src/cli.ts render",
    "check": "tsx src/cli.ts check",
    "fmt": "tsx src/cli.ts fmt",
    "prompt": "tsx src/cli.ts prompt",
    "playground": "tsx src/cli.ts playground",
    "skill": "tsx skill/build.ts",
    "docs": "tsx docs/build.ts",
    "typecheck": "tsc",
    "examples": "for f in examples/*.tsq; do tsx src/cli.ts render $f -o ${f%.tsq}.png --scale 2; done",
    "eval:prompts": "tsx eval/prompts.ts",
    "eval:score": "tsx eval/score.ts",
    "regressions": "tsx scripts/regressions.ts",
    "build": "tsx scripts/build.ts",
    "prepare": "npm run build",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@json-render/core": "^0.21.0",
    "@json-render/image": "0.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": ">=20",
    "@types/react": "^19.3.0",
    "lucide": "1.48.0",
    "react": "^19.3.0",
    "satori": "0.19.3",
    "simple-icons": "16.34.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "^4.0.0",
    "jiti": "1.21.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
